# 后端 API 地址（开发环境默认已在 vite.config.ts 中代理到 http://127.0.0.1:8000，无需手动配置）
# 生产环境请在构建时替换 VITE_API_BASE_URL
# VITE_API_BASE_URL=https://your-backend.example.com

# Live2D 模型资源地址（可选，未配置时显示占位角色）
# VITE_LIVE2D_MODEL_URL=https://your-cdn.example.com/path/to/model.model3.json

# 功能开关
VITE_ENABLE_LIVE2D=false
VITE_ENABLE_VOICE=false
